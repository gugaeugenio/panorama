# Copie este arquivo para ".env" (na mesma pasta) e preencha a chave.
# Crie a chave em https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=

# Modelo que escreve as matérias. Custo aproximado por matéria (5 mil tokens lidos, 2 mil escritos):
#   claude-opus-5-5    melhor texto   ~US$ 0,06   (~110 matérias/dia: ~US$ 6,60/dia)
#   claude-sonnet-5-5  muito bom      ~US$ 0,03   (~US$ 3,30/dia)
#   claude-haiku-5-5   bom e barato   ~US$ 0,0015 (~US$ 0,17/dia)
PANORAMA_MODELO=claude-opus-5-5

# Esforço de raciocínio: low, medium ou high. Mais alto custa mais.
PANORAMA_ESFORCO=medium

# Máximo de matérias redigidas por dia (trava de custo).
PANORAMA_LIMITE_DIARIO=120
